{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edge-security-ai",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SecurityAgent",
        "class_name": "SecurityAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SecurityAgent"]
    }
  ]
}
